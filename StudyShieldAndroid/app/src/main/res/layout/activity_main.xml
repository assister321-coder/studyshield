<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117">

    <TextView android:text="🛡️ StudyShield" android:textColor="#FFFFFF"
        android:textSize="22sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <Switch android:id="@+id/switchActive" android:text="StudyShield Active"
        android:textColor="#FFFFFF" android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView android:text="Reels Blocked Today: 0" android:id="@+id/tvCount"
        android:textColor="#818CF8" android:textSize="18sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <Button android:id="@+id/btnAccessibility" android:text="Enable Accessibility Service"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" />

    <Button android:id="@+id/btnOverlay" android:text="Allow Overlay Permission"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
</LinearLayout>
